{
  "name": "himmel-store",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate -w @himmel/db",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=18"
  },

  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
